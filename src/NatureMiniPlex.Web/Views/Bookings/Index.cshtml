@model IEnumerable<Showtime>
@{
    ViewData["Title"] = "จองตั๋ว";
    var cart = (IReadOnlyList<CartLine>)ViewBag.Cart;
}

<div class="row g-4">
    <div class="col-lg-8">
        <h1 class="h3">รอบที่เปิดจอง</h1>
        <p class="text-secondary">เลือกที่นั่งได้หลายรอบและหลายเรื่อง รวมกันไม่เกิน 4 ที่นั่งต่อการจอง</p>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>วันที่</th>
                    <th>โรง</th>
                    <th>เรื่อง</th>
                    <th>รอบ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var show in Model)
                {
                    <tr>
                        <td>@ThaiDate.Day(show.ShowDate)</td>
                        <td>@show.Cinema.CinemaName</td>
                        <td>@show.Movie.Title</td>
                        <td>@ShowSlotNames.Thai(show.Slot)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" asp-action="Show" asp-route-id="@show.ShowtimeId">เลือกที่นั่ง</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">รายการที่จะจอง (@cart.Count/4)</h2>
                @if (cart.Count == 0)
                {
                    <p class="mb-0">ยังไม่ได้เลือกที่นั่ง รายการนี้ยังไม่ถูกบันทึก</p>
                }
                else
                {
                    <ul class="list-unstyled">
                        @foreach (var line in cart)
                        {
                            <li class="mb-2">
                                <div>@line.CinemaName</div>
                                <div>@line.MovieTitle</div>
                                <div>@line.WhenText ที่นั่ง @line.SeatCode</div>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="showtimeId" value="@line.ShowtimeId" />
                                    <input type="hidden" name="seatId" value="@line.SeatId" />
                                    <button class="btn btn-sm btn-link px-0" type="submit">เอาออก</button>
                                </form>
                            </li>
                        }
                    </ul>
                    <form asp-action="Confirm" method="post">
                        <label class="form-label" for="phone">เบอร์โทรศัพท์</label>
                        <input class="form-control mb-2" id="phone" name="phone" inputmode="numeric" placeholder="08xxxxxxxx" />
                        <button class="btn btn-success w-100" type="submit">ยืนยันการจอง</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
