@model SeatMapView
@{
    ViewData["Title"] = "เลือกที่นั่ง";
    var cart = (IReadOnlyList<CartLine>)ViewBag.Cart;
}

<h1 class="h3">@Model.MovieTitle</h1>
<p>@Model.CinemaName · @ThaiDate.Day(Model.ShowDate) · รอบ@(ShowSlotNames.Thai(Model.Slot))</p>
<p class="text-secondary">รายการจองตอนนี้ @cart.Count/4 ที่นั่ง</p>

@if (Model.Closed)
{
    <div class="alert alert-warning">@Model.ClosedReason</div>
}

<form asp-action="Add" method="post">
    <input type="hidden" name="showtimeId" value="@Model.ShowtimeId" />
    <div class="screen">จอ</div>
    @foreach (var row in Model.Seats.GroupBy(seat => seat.SeatRow))
    {
        <div class="seat-row" style="grid-template-columns: repeat(@Model.ColumnCount, minmax(72px, 1fr));">
            @foreach (var seat in row)
            {
                var css = seat.Booked ? "booked" : seat.InCart ? "in-cart" : Model.Closed ? "closed" : "";
                if (seat.Booked || seat.InCart || Model.Closed)
                {
                    <div class="seat @css">
                        <span>@seat.SeatCode</span>
                        <small>@(seat.Booked ? "จองแล้ว" : seat.InCart ? "อยู่ในรายการ" : "ปิด")</small>
                    </div>
                }
                else
                {
                    <label class="seat">
                        <input type="checkbox" name="seatIds" value="@seat.SeatId" />
                        <span>@seat.SeatCode</span>
                    </label>
                }
            }
        </div>
    }
    @if (!Model.Closed)
    {
        <button class="btn btn-primary mt-3" type="submit">ใส่รายการจอง</button>
    }
</form>

<p class="mt-3"><a asp-action="Index">กลับไปยืนยันการจอง</a></p>
