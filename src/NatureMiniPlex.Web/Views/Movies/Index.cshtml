@model IEnumerable<Movie>
@{
    ViewData["Title"] = "เรื่องหนัง";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">เรื่องหนัง</h1>
    <a class="btn btn-primary" asp-action="Create">เพิ่มเรื่อง</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ชื่อเรื่อง</th>
            <th>วันเริ่มฉาย</th>
            <th>วันสิ้นสุด</th>
            <th>สถานะ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@ThaiDate.Day(movie.StartDate)</td>
                <td>@ThaiDate.Day(movie.StopDate)</td>
                <td>@StatusNames.Movie(movie.Status)</td>
                <td class="text-end">
                    @if (movie.Status == MovieStatus.Active)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@movie.MovieId">แก้ไข</a>
                        <form class="d-inline" asp-action="Cancel" method="post" onsubmit="return confirm('ยกเลิกเรื่องนี้และรอบในอนาคตที่ยังไม่ถูกจอง?');">
                            <input type="hidden" name="id" value="@movie.MovieId" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">ยกเลิกเรื่อง</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
