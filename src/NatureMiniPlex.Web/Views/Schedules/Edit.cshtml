@model ScheduleDayView
@{
    ViewData["Title"] = "จัดการรอบฉาย";
}

<h1 class="h3">@Model.CinemaName</h1>
<p>วันที่ @ThaiDate.Day(Model.ShowDate)</p>

@if (Model.Locked)
{
    <div class="alert alert-warning">@Model.LockReason</div>
}

@if (Model.Movies.Count == 0)
{
    <p>ยังไม่มีเรื่องที่เปิดอยู่และครอบคลุมวันนี้ <a asp-controller="Movies" asp-action="Create">เพิ่มเรื่องหนัง</a></p>
}
else
{
    <form asp-action="Edit" method="post" class="col-lg-6">
        <input type="hidden" name="cinemaId" value="@Model.CinemaId" />
        <input type="hidden" name="showDate" value="@Model.ShowDate.ToString("yyyy-MM-dd")" />
        <div class="mb-3">
            <label class="form-label" for="movieId">เรื่องที่ฉายทั้งวัน</label>
            <select class="form-select" id="movieId" name="movieId" @(Model.Locked ? "disabled" : null)>
                @foreach (var movie in Model.Movies)
                {
                    if (Model.MovieId == movie.MovieId)
                    {
                        <option value="@movie.MovieId" selected>@movie.Title</option>
                    }
                    else
                    {
                        <option value="@movie.MovieId">@movie.Title</option>
                    }
                }
            </select>
        </div>
        <div class="mb-3">
            @foreach (var slot in ShowSlotNames.All)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="slots" value="@((int)slot)" id="slot-@slot" @(Model.Slots.Contains(slot) ? "checked" : null) @(Model.Locked ? "disabled" : null) />
                    <label class="form-check-label" for="slot-@slot">@ShowSlotNames.Thai(slot)</label>
                </div>
            }
        </div>
        @if (!Model.Locked)
        {
            <button class="btn btn-primary" type="submit">บันทึกรอบของวันนี้</button>
        }
    </form>
}

@if (!Model.Locked && Model.Slots.Count > 0)
{
    <form class="mt-3" asp-action="CancelDay" method="post" onsubmit="return confirm('ยกเลิกรอบทั้งหมดของวันนี้?');">
        <input type="hidden" name="cinemaId" value="@Model.CinemaId" />
        <input type="hidden" name="showDate" value="@Model.ShowDate.ToString("yyyy-MM-dd")" />
        <button class="btn btn-outline-danger" type="submit">ยกเลิกรอบทั้งหมดของวันนี้</button>
    </form>
}

<p class="mt-3"><a asp-action="Index">กลับหน้ารอบฉาย</a></p>
